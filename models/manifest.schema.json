{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockcontrol.invalid/models/manifest.schema.json",
  "title": "StockControl model manifest",
  "description": "Schema-version-1 documentation for the build-time model manifest. fetch_models.py is authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "models"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "models": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "repoId",
        "revision",
        "licence",
        "preprocessingId",
        "files"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "repoId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "preprocessingId": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\\\/])(?!.*[\\\\])(?!.*//)(?!.*(^|/)\\.{1,2}(/|$)).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
