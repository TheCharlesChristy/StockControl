{
  "name": "@stockcontrol/platform-database",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "clean": "tsc -b tsconfig.build.json --clean",
    "migrate": "node --env-file-if-exists=../../../.env --import tsx src/migrate.ts",
    "migrate:prod": "node dist/migrate.js",
    "test": "vitest run --configLoader runner",
    "test:coverage": "vitest run --coverage --configLoader runner",
    "test:integration": "vitest run --config vitest.integration.config.ts --configLoader runner",
    "test:unit": "vitest run --configLoader runner",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@stockcontrol/contracts": "workspace:*",
    "@stockcontrol/module-system": "workspace:*",
    "kysely": "^0.28.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "^4.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
