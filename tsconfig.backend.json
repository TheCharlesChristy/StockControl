{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@stockcontrol/contracts": ["packages/contracts/src/index.ts"],
      "@stockcontrol/module-system": ["packages/modules/system/src/index.ts"],
      "@stockcontrol/module-locations": ["packages/modules/locations/src/index.ts"],
      "@stockcontrol/module-stock-capture": ["packages/modules/stock-capture/src/index.ts"],
      "@stockcontrol/platform": ["packages/platform/core/src/index.ts"],
      "@stockcontrol/platform-database": ["packages/platform/database/src/index.ts"],
      "@stockcontrol/testkit": ["packages/testkit/src/index.ts"]
    },
    "types": ["node"],
    "verbatimModuleSyntax": false
  }
}
