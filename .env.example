NODE_ENV=development
APP_VERSION=dev
BUILD_TIMESTAMP=
GIT_SHA=local
HOST=0.0.0.0
PORT=3000
API_ORIGIN=http://127.0.0.1:3000
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
ALLOWED_WEB_ORIGINS=http://localhost:5173
VITE_ENABLE_AUTH_PREVIEW=false
DATABASE_URL=postgresql://stockcontrol_app:stockcontrol_app@localhost:5432/stockcontrol
DATABASE_MIGRATOR_URL=postgresql://stockcontrol_migrator:stockcontrol_migrator@localhost:5432/stockcontrol
DATABASE_RUNTIME_ROLE=stockcontrol_app
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=stockcontrol-local
S3_ACCESS_KEY_ID=stockcontrol
S3_SECRET_ACCESS_KEY=stockcontrol-local-only
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=StockControl <no-reply@stockcontrol.local>
LOG_LEVEL=debug
