NODE_ENV=development
APP_VERSION=dev
BUILD_TIMESTAMP=
GIT_SHA=local
HOST=0.0.0.0
PORT=3000
# The worker's health server falls back to PORT when unset (for Railway,
# where each service gets its own PORT). Locally, api and worker share this
# .env file, so this must be set to avoid both binding :3000.
WORKER_HEALTH_PORT=3001
API_ORIGIN=http://127.0.0.1:3000
WEB_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
ALLOWED_WEB_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://stockcontrol_app:stockcontrol_app@localhost:5432/stockcontrol
DATABASE_MIGRATOR_URL=postgresql://stockcontrol_migrator:stockcontrol_migrator@localhost:5432/stockcontrol
DATABASE_RUNTIME_ROLE=stockcontrol_app
LOG_LEVEL=debug
