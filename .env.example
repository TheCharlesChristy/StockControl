NODE_ENV=development
APP_VERSION=dev
BUILD_TIMESTAMP=
GIT_SHA=local
HOST=0.0.0.0
PORT=3000
# The worker's health server falls back to PORT when unset (for Railway,
# where each service gets its own PORT). Locally, api and worker share this
# .env file, so this must be set to avoid both binding :3000.
WORKER_HEALTH_PORT=3001
API_ORIGIN=http://127.0.0.1:3000
PUBLIC_APP_ORIGIN=http://localhost:5173
# How many reverse proxies sit in front of the API. This decides which entry of
# X-Forwarded-For becomes request.ip, which keys the per-source sign-in
# throttle, so raise it only for a deployment that really has more hops and
# whose every hop rewrites the header. Default 1, for the Nginx web service.
TRUSTED_PROXY_HOPS=1
# Assisted stock capture. Off unless this is exactly "true", which is why the
# "Add stock" navigation entry is invisible on a default local install. Turning
# it on also needs the worker running — see
# docs/operations/railway-stock-capture.md.
STOCK_CAPTURE_ENABLED=false
# Private ChatGPT MCP integration. Keep all three flags false until the
# migration, audit, OAuth and staging evaluation gates have passed.
MCP_ENABLED=false
MCP_READ_TOOLS_ENABLED=false
MCP_WRITE_TOOLS_ENABLED=false
MCP_PUBLIC_BASE_URL=http://localhost:3000
MCP_CLIENT_ID=stockcontrol-chatgpt
MCP_REDIRECT_URI=http://localhost:3000/oauth/callback
MCP_ACCESS_TOKEN_MINUTES=15
MCP_REFRESH_TOKEN_DAYS=30
MCP_MAX_TOOL_SECONDS=30
# GitHub issue reporting is performed by the API; use a fine-grained token with
# Issues: Read and write permission on this repository.
GITHUB_REPOSITORY=TheCharlesChristy/StockControl
GITHUB_TOKEN=
DATABASE_URL=postgresql://stockcontrol_app:stockcontrol_app@localhost:5432/stockcontrol
DATABASE_MIGRATOR_URL=postgresql://stockcontrol_migrator:stockcontrol_migrator@localhost:5432/stockcontrol
DATABASE_RUNTIME_ROLE=stockcontrol_app
LOG_LEVEL=debug
# Private S3-compatible floor-plan and user/item photo storage (local Compose defaults to MinIO).
FLOOR_PLAN_S3_ENDPOINT=http://127.0.0.1:9000
FLOOR_PLAN_S3_BUCKET=stockcontrol-floor-plans
FLOOR_PLAN_S3_REGION=us-east-1
FLOOR_PLAN_S3_ACCESS_KEY=stockcontrol_minio
FLOOR_PLAN_S3_SECRET_KEY=stockcontrol_minio_password
FLOOR_PLAN_S3_URL_STYLE=path
FLOOR_PLAN_MAX_BYTES=10485760
# Private user/item photos use the same bucket and adapter as floor plans.
PHOTO_MAX_BYTES=10485760
