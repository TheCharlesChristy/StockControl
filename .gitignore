# Dependencies and generated output
node_modules/
.pnpm-store/
dist/
coverage/
.turbo/

# Test output
playwright-report/
test-results/

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
infra/ansible/group_vars/vault.yml
infra/ansible/inventory/hosts.yml
infra/ansible/**/*.vault.yml

# Local service data
.local-data/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Terraform
*.tfstate
*.tfstate.*
.terraform/

*.log
*.pid
*.pid.lock

# TypeScript incremental build state
*.tsbuildinfo

# Python bytecode (services/recognition-core). uv, mypy, pytest and ruff each
# drop their own .gitignore inside their own cache/venv directories, so only
# the bare interpreter cache needs a rule here.
__pycache__/
*.pyc
