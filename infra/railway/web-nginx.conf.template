map $http_x_forwarded_proto $stockcontrol_forwarded_proto {
    default $scheme;
    ~*^https$ https;
}

limit_req_zone $binary_remote_addr zone=stockcontrol_mcp_by_ip:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=stockcontrol_oauth_by_ip:10m rate=10r/m;
limit_req_status 429;

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Ten-megabyte images become roughly 13.4 MiB when encoded in JSON. Keep
    # the edge limit aligned with the API's 16 MiB Fastify body limit.
    client_max_body_size 16m;

    # Capture and floor-plan uploads use short-lived presigned URLs from the
    # Tigris S3-compatible endpoint. The API remains same-origin; only the
    # browser's direct PUT to the storage provider needs this additional
    # connect-src host allowlist.
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.storageapi.dev https://storageapi.dev; font-src 'self' data: https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'none'; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; worker-src 'self' blob:" always;
    add_header Permissions-Policy "camera=(self), geolocation=(), microphone=()" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;

    # nginx replaces the inherited add_header set rather than merging with it,
    # so a location that adds one header of its own drops every header above.
    # The security set is therefore repeated here in full. Any new location
    # that needs its own add_header has to do the same.
    location = /health {
        access_log off;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Type text/plain always;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    # Use the resolver supplied by the container's /etc/resolv.conf. Keeping
    # proxy_pass variable-based makes nginx re-resolve Railway private DNS as
    # API deployments move between hosts.
    resolver ${NGINX_RESOLVER} valid=30s;

    location /api/ {
        set $api_upstream http://${API_HOST}:${API_PORT};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $stockcontrol_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # OAuth sign-in starts in ChatGPT. This is the sole browser-app document
    # that may be embedded there; all other StockControl pages stay protected
    # by the server-level frame deny policy above.
    location = /sign-in {
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://*.storageapi.dev https://storageapi.dev; font-src 'self' data: https://fonts.gstatic.com; form-action 'self'; frame-ancestors https://chatgpt.com; img-src 'self' data: blob:; media-src 'self' blob:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; worker-src 'self' blob:" always;
        add_header Permissions-Policy "camera=(self), geolocation=(), microphone=()" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        # Keep the request in this location so its ChatGPT frame policy is not
        # replaced by the deny-by-default policy on the general SPA location.
        try_files /index.html =404;
    }

    # The MCP streamable HTTP endpoint is the only public path that can carry
    # bearer-authenticated tool calls. Keep the API private and disable proxy
    # buffering so JSON-RPC responses are delivered promptly.
    location = /mcp {
        set $stockcontrol_mcp_enabled ${MCP_ENABLED};
        if ($stockcontrol_mcp_enabled != true) { return 404; }
        set $api_upstream http://${API_HOST}:${API_PORT};
        limit_req zone=stockcontrol_mcp_by_ip burst=20 nodelay;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $stockcontrol_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_send_timeout 30s;
        client_max_body_size 1m;
    }

    location = /.well-known/oauth-protected-resource {
        set $stockcontrol_mcp_enabled ${MCP_ENABLED};
        if ($stockcontrol_mcp_enabled != true) { return 404; }
        set $api_upstream http://${API_HOST}:${API_PORT};
        limit_req zone=stockcontrol_oauth_by_ip burst=10 nodelay;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $stockcontrol_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 64k;
    }

    location = /.well-known/oauth-authorization-server {
        set $stockcontrol_mcp_enabled ${MCP_ENABLED};
        if ($stockcontrol_mcp_enabled != true) { return 404; }
        set $api_upstream http://${API_HOST}:${API_PORT};
        limit_req zone=stockcontrol_oauth_by_ip burst=10 nodelay;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $stockcontrol_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 64k;
    }

    location = /oauth/authorize {
        set $stockcontrol_mcp_enabled ${MCP_ENABLED};
        if ($stockcontrol_mcp_enabled != true) { return 404; }
        set $api_upstream http://${API_HOST}:${API_PORT};
        limit_req zone=stockcontrol_oauth_by_ip burst=10 nodelay;
        # The API emits a request-specific consent CSP. Preserve it here: the
        # form-action origin is the public app origin, not the opaque origin of
        # ChatGPT's sandboxed frame. Do not add X-Frame-Options: DENY, as it
        # would override the CSP allowance in older user agents.
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Content-Type-Options;
        add_header Permissions-Policy "camera=(), geolocation=(), microphone=()" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $stockcontrol_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 64k;
    }

    location = /oauth/token {
        set $stockcontrol_mcp_enabled ${MCP_ENABLED};
        if ($stockcontrol_mcp_enabled != true) { return 404; }
        set $api_upstream http://${API_HOST}:${API_PORT};
        limit_req zone=stockcontrol_oauth_by_ip burst=10 nodelay;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $stockcontrol_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 64k;
    }

    location = /oauth/revoke {
        set $stockcontrol_mcp_enabled ${MCP_ENABLED};
        if ($stockcontrol_mcp_enabled != true) { return 404; }
        set $api_upstream http://${API_HOST}:${API_PORT};
        limit_req zone=stockcontrol_oauth_by_ip burst=10 nodelay;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $stockcontrol_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
        client_max_body_size 64k;
    }

    location ^~ /oauth/ {
        return 404;
    }

    location ^~ /.well-known/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
