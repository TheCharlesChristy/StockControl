{
  "name": "stockcontrol",
  "version": "0.1.0",
  "private": true,
  "description": "StockControl inventory management product",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm build:backend && pnpm build:web",
    "build:backend": "tsc -b tsconfig.build.json",
    "build:web": "pnpm --filter @stockcontrol/web build",
    "clean": "tsc -b tsconfig.build.json --clean && pnpm -r --if-present clean",
    "db:bootstrap:roles:prod": "pnpm --filter @stockcontrol/platform-database bootstrap:roles:prod",
    "db:migrate": "pnpm --filter @stockcontrol/platform-database migrate",
    "db:migrate:prod": "pnpm --filter @stockcontrol/platform-database migrate:prod",
    "db:seed": "pnpm --filter @stockcontrol/api seed",
    "setup:first-admin:prod": "pnpm --filter @stockcontrol/api setup:first-admin:prod",
    "dev": "pnpm -r --parallel --if-present dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "test:integration": "pnpm --filter @stockcontrol/platform-database test:integration && pnpm --filter @stockcontrol/api test:integration",
    "test:e2e": "pnpm --filter @stockcontrol/e2e test:e2e",
    "quality": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "reset:admin-password:prod": "pnpm --filter @stockcontrol/api reset:admin-password:prod",
    "services:up": "docker compose up -d --wait postgres minio && docker compose run --rm minio-init",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "dev:manager:start": "node ./scripts/dev-server-manager.mjs start",
    "dev:manager:stop": "node ./scripts/dev-server-manager.mjs stop",
    "dev:manager:status": "node ./scripts/dev-server-manager.mjs status",
    "dev:manager:logs": "node ./scripts/dev-server-manager.mjs logs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "10.8.0",
    "eslint-plugin-boundaries": "7.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
